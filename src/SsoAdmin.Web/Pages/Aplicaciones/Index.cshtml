@page
@model SsoAdmin.Web.Pages.Aplicaciones.IndexModel
@{
    ViewData["Title"] = "Aplicaciones";
}

<h1 class="h3 mb-4">Aplicaciones</h1>

<form id="crear-aplicacion-form" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" class="form-control" id="nombre" placeholder="Nombre" required />
    </div>
    <div class="col-auto">
        <input type="text" class="form-control" id="url" placeholder="https://..." required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Registrar aplicación</button>
    </div>
</form>

<div id="aplicacion-error" class="alert alert-danger d-none" role="alert"></div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>URL</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody id="aplicaciones-tbody"></tbody>
</table>

@section Scripts {
    <script src="~/js/aplicaciones.js" asp-append-version="true"></script>
}
